# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.angular
.claude
package-lock.json
dist
dist-ssr
*.local
*.exe

# QZ Tray signing keys — never commit the private key or the generated cert
backend/qz/keys/*.pem
backend/qz/keys/*.txt
!backend/qz/keys/.gitkeep

# QZ Tray root CA — root-ca-key.pem can mint certs QZ Tray will silently trust; never commit it
backend/qz/root-ca/*.pem

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
